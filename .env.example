# Prizm Lounge Production Hub - Environment Variables
# Copy this file to .env.local for local development

# Required: Anthropic API Key for Claude AI content generation
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Supabase for real-time clip markers sync across users
# Get your keys at: https://supabase.com/dashboard/project/_/settings/api
# If not configured, clip markers will still work locally via localStorage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
